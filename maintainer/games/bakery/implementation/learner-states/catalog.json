    {"id":"08-bake-trays","through":8,"tutorial_step":8,"action":"MultiplyModifier","introduces_variables":[],"uses_variables":["batch","modifierNumber"],"operator":"*","comparison":null,"statements":["batch = bakery.trayAmount()","modifierNumber = bakery.modifierNumber()","batch = batch * modifierNumber","bakery.applyResult(batch)"],"claim":"A separately authored multiplication reads the selected tray and ×3 modifier's printed number, then triples the current amount."},
    {"id":"09-pack-boxes","through":9,"tutorial_step":9,"action":"DivideModifier","introduces_variables":[],"uses_variables":["batch","modifierNumber"],"operator":"/","comparison":null,"statements":["batch = bakery.trayAmount()","modifierNumber = bakery.modifierNumber()","batch = batch / modifierNumber","bakery.applyResult(batch)"],"claim":"A separately authored division reads the selected tray and /3 modifier's printed number, then stores the quotient; all earlier modifiers remain available."},
    {"id":"10-equal-check","through":10,"tutorial_step":10,"action":"EqualCheck","introduces_variables":["leftCakes","rightCakes","ready"],"uses_variables":["leftCakes","rightCakes","ready"],"operator":null,"comparison":"==","statements":["leftCakes = bakery.leftAmount()","rightCakes = bakery.rightAmount()","ready = leftCakes == rightCakes","bakery.showCheck(ready)"],"claim":"The learner reads both cake trays, compares their amounts, stores the true or false result in ready, and displays that Boolean check."},
