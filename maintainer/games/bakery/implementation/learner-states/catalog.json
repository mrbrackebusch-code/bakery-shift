    {"id":"05-pack-pairs","through":5,"tutorial_step":5,"action":"Halve","introduces_variables":[],"uses_variables":["batch"],"operator":"/","comparison":null,"statements":["batch = bakery.trayAmount()","batch = batch / 2","bakery.applyResult(batch)"],"claim":"Placing a /2 modifier reads the chosen tray and stores half its current amount; this is a tray transformation, not box packing."},
